# Exclude non-runtime files from `git archive` output.
# Used by skills/moviola/scripts/build-skill.sh to produce the claude.ai .skill file
# and by Claude Code's /plugin install (full-repo archive).

# Anthropic canonical skill-packaging excludes
# (mirrors anthropics/skills/skills/skill-creator/scripts/package_skill.py)
__pycache__/   export-ignore
node_modules/  export-ignore
*.pyc          export-ignore
.DS_Store      export-ignore

# Dev, docs, test, and media — not needed at skill runtime
tests/         export-ignore
docs/          export-ignore
fixtures/      export-ignore
assets/        export-ignore
examples/      export-ignore

# Dev tooling and planning notes — repo-only, not shipped to any install surface
dev-sync.sh      export-ignore
V2_PLAN.md       export-ignore
V2_CONCERNS.md   export-ignore
.agents/         export-ignore

# Dev-only build script + scanner config inside the skill tree: these live in
# skills/moviola/.gitattributes, NOT here. `export-ignore` matches relative to the
# archive root, and the claude.ai bundle is `git archive HEAD:skills/moviola` — so
# a pattern written here as `skills/moviola/...` never matches that archive. It was
# written here, and both files shipped in every bundle until 2026-08-26.

# NOTE: hooks/ and .claude-plugin/ are NOT export-ignored because Claude Code's
# /plugin install fetches the full-repo git archive — they must be present for
# the plugin to install correctly. The claude.ai .skill bundle is built from the
# skills/moviola/ subtree only, so it never sees them in the first place.

# CI workflows — repo-only, not needed at skill runtime
.github/         export-ignore

# Build config itself
.gitignore      export-ignore
.gitattributes  export-ignore

# Install-time scanner config. `.skillignore` tells scanners which paths NOT to read,
# and 6 of this one's 23 entries name paths that DO ship in this archive: `.claude-plugin/`
# and `hooks/` — both deliberately kept, see the NOTE above — plus README.md, CHANGELOG.md,
# AGENTS.md and CLAUDE.md. So the shipped file was not an inert leftover. It told an
# install-time scanner to skip `hooks/scripts/check-setup.sh`, an executable that ships and
# runs on SessionStart, and both plugin manifests. Measured 2026-08-27 by enumerating every
# entry against `git archive HEAD`, not inferred.
# EXPORT-IGNORED rather than deleted — but NOT because another surface reads it. `npx skills
# add` clones rather than archiving (so `export-ignore` could not reach it there anyway) and
# then copies only skills/moviola/, never the repository root; the `skills` CLI does not read
# `.skillignore` under any name. The file is kept for the one surface it still serves: a
# scanner pointed at a CHECKOUT of this repository reads it from disk, where no archive
# attribute applies.
# The leading slash anchors this to the repository root so it does not also match
# skills/moviola/.skillignore, which skills/moviola/.gitattributes:16 already excludes
# for its own reasons.
# Pinned by TestThePluginInstallArchiveShipsNoScannerConfig.
/.skillignore   export-ignore
